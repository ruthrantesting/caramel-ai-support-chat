GOOGLE_API_KEY=

# User authentication (specs/002-user-auth)
# Leave AUTH_DB_* unset to use the embedded development file database (backend/data/).
# Uncomment and set all three to use PostgreSQL in production. An empty value overrides the default, so do not leave them blank.
# AUTH_DB_URL=jdbc:postgresql://HOST:5432/DBNAME
# AUTH_DB_USER=
# AUTH_DB_PASSWORD=
# true by default. Set to false only for local HTTP, when the browser rejects a Secure cookie.
SESSION_COOKIE_SECURE=true
